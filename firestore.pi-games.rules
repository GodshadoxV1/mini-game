rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // On a shared project, merge only this match into the existing rules.
    // piGamesBackups/{uid}: one private progression snapshot per Firebase account.
    match /piGamesBackups/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isValidBackup() {
        let backup = request.resource.data;
        return backup.keys().hasAll(['version', 'payload', 'updatedAt'])
          && backup.keys().hasOnly(['version', 'payload', 'updatedAt'])
          && backup.version is int && backup.version == 1
          && backup.payload is string && backup.payload.size() <= 180000
          && backup.updatedAt == request.time;
      }

      allow get: if isOwner();
      allow create, update: if isOwner() && isValidBackup();
    }
  }
}
